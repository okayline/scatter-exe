{
  // SCATTER.EXE. The Worker's name must match the one in the Cloudflare dashboard.
  "name": "scatter-exe",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // the page (public/). /api/* goes to the Worker code first.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // (v0.2.0) save codes, passkeys and the carried copy: the shared Accounts and Registry (dungeon-items)
  "services": [
    { "binding": "ACCOUNTS", "service": "dungeon-items", "entrypoint": "Accounts" },
    { "binding": "REGISTRY", "service": "dungeon-items", "entrypoint": "Registry" }
  ],
  // SCATTER.EXE's tables live in the moba-beat database; every one of them is named scatter_...
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moba-beat",
      "database_id": "8ced4f17-0ae0-4852-b02c-5003d7f08c5d"
    }
  ]
}
