{
  // SCATTER.EXE. The Worker's name must match the one in the Cloudflare dashboard.
  "name": "scatter-exe",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // the page (public/). /api/* goes to the Worker code first.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scatter-db",
      // from: npx wrangler d1 create scatter-db (not made yet)
      "database_id": ""
    }
  ]
}
